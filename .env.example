# Copy to .env.local. Live calls happen ONLY when MOCK_MODE=false and a key is set.
MOCK_MODE=true
ANTHROPIC_API_KEY=
# Hard cap on estimated live Claude API spend (USD) recorded in data/spend_ledger.json
LIVE_SPEND_CAP_USD=10
# Optional: alternative data directory (defaults to ./data). The older name AGENTTRUST_DATA_DIR still works.
# EVALXIETY_DATA_DIR=
# Optional: folder holding your agents (agents/<id>/agent.json + cases.jsonl); defaults to ./agents
# EVALXIETY_AGENTS_DIR=
# Secrets your agent's HTTP endpoint needs, referenced in its agent.json headers as ${env:NAME}. An agent can only read
# names starting with EVALXIETY_AGENT_<AGENT_ID>_ (folder name in capitals, - as _), so a copied agent.json can't read
# ANTHROPIC_API_KEY, other credentials, or another agent's token. For agents/my-agent:
# EVALXIETY_AGENT_MY_AGENT_TOKEN=
# Optional: extra Host names the API accepts besides localhost / 127.0.0.1 / [::1] (comma-separated). To serve on a
# LAN name you must also start Next with -H 0.0.0.0.
# EVALXIETY_ALLOWED_HOSTS=
