# Copy to .env.local. Live calls happen ONLY when MOCK_MODE=false and a key is set.
MOCK_MODE=true
ANTHROPIC_API_KEY=
# Hard cap on estimated live Claude API spend (USD) recorded in data/spend_ledger.json
LIVE_SPEND_CAP_USD=10
# Optional: alternative data directory (defaults to ./data)
# AGENTTRUST_DATA_DIR=
