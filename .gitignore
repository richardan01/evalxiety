# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.swp
*~

# editors (personal settings)
.idea/
.vscode/

# keys and certificates
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# browser-test output
/test-results/
/playwright-report/
/blob-report/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# The demo's data. data/ is the tracked seed (the live run's traces, labels and LLM cache); the app works on a copy in
# .data/ (made from data/ on first `npm run dev` or `npm start`), so using it never changes tracked files. Delete .data/
# to reset the demo.
/.data/
/data/**/*.tmp

# The npm package built by `npm run build:npm` (published from dist/npm).
/dist/
.env.local
!.env.example

# Local pre-publish review stamps (not part of the project)
*.riddler-passed
*.vicki-passed

# Your agents: definitions and traces can contain private data, so they stay out of git (and out of a public
# fork) by default. Delete these lines, or point EVALXIETY_AGENTS_DIR at your own repo, to version them.
/agents/*
!/agents/example-support-bot/
!/agents/_template/
!/agents/custom-checks.ts
/data/agents/

# A Claude API key connected from the UI (data/ is tracked, so keep secrets out of it).
/data/private/

# Claude Code: personal settings, local memory and lock files (the shared launch config stays tracked)
/.claude/scheduled_tasks.lock
/.claude/*.lock
/.claude/settings.local.json
CLAUDE.local.md

# Spreadsheets of test questions or agent answers can hold customer data, so they never go in by accident.
# Need one as a fixture? Add it on purpose with `git add -f`.
*.csv
*.tsv
*.xlsx
*.xls

# Release reports you download or print from the app
release-report-*.md
release-report-*.pdf
