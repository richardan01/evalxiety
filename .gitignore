# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AgentTrust local data (traces, labels, LLM cache). Delete to reset.
# data/ is tracked so experiment runs, traces, labels and the LLM cache are recoverable.
# Temporary run artefacts only:
/data/**/*.tmp
.env.local
!.env.example

# Local pre-publish review stamps (not part of the project)
*.riddler-passed
*.vicki-passed

# Your agents: definitions and traces can contain private data, so they stay out of git (and out of a public
# fork) by default. Delete these lines, or point EVALXIETY_AGENTS_DIR at your own repo, to version them.
/agents/*
!/agents/example-support-bot/
!/agents/_template/
!/agents/custom-checks.ts
/data/agents/

# A Claude API key connected from the UI (data/ is tracked, so keep secrets out of it).
/data/private/

# Claude Code local scheduler lock
/.claude/scheduled_tasks.lock
